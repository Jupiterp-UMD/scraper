# Credentials for everything in db/. Copy to db/.env and fill in.
#
# db/.env is gitignored. Read by clone_via_api.py and clone_project.sh, and
# by db/load_env.sh for everything else. Anything already exported in the
# environment wins over this file, so a one-off override still works:
#
#   TARGET_DB_URL=postgresql://... ./db/clone_project.sh --dry-run
#
# Comments: a whole line starting with `#`, or ` #` after an unquoted value.
# A `#` with no space before it is kept, so `p#ss` in a connection string is
# safe. To keep a literal ` #`, quote the value: KEY='pa ss #word'.

# --- supabase db push, psql ----------------------------------------------
#
# The *session* connection string from the Supabase dashboard
# (Settings -> Database), NOT the PostgREST DATABASE_URL the scraper uses.
# The Supabase CLI does not read this file and needs the URL percent-encoded:
#
#   source db/load_env.sh && load_env_file
#   npx supabase db push --db-url "$DATABASE_DIRECT_URL" --dry-run
#
# Point this at the TEST project until the migration has been rehearsed.
DATABASE_DIRECT_URL=postgresql://postgres:xxxxxxxx@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# --- clone_via_api.py -----------------------------------------------------
#
# Personal access tokens, generated per account at
# https://supabase.com/dashboard/account/tokens. These grant full Management
# API access to every project on the account they belong to -- treat them like
# a password, and rotate if one leaks.

# Source: the project to copy FROM (production).
SOURCE_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SOURCE_REF=xxxxxxxxxxxxxxxxxxxx

# Target: the project to copy TO. Its public schema is DROPPED and recreated.
TARGET_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TARGET_REF=xxxxxxxxxxxxxxxxxxxx

# --- clone_project.sh -----------------------------------------------------
#
# The pg_dump/pg_restore route. Needs the database password for both projects
# and a route to port 5432; unnecessary if you clone via the API instead.
SOURCE_DB_URL=postgresql://postgres:xxxxxxxx@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
TARGET_DB_URL=postgresql://postgres:xxxxxxxx@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
